# Backend PDF Processing Service URL (FastAPI)
PDF_SERVICE_URL=http://127.0.0.1:8000

# Next.js Port
PORT=3000

# Database Configuration
# When MONGODB_URI is provided, data persists in MongoDB.
# When offline or absent, persistent local file storage adapter is used automatically.
MONGODB_URI=mongodb://localhost:27017/bank_statement_analyzer
MONGODB_DB_NAME=bank_statement_analyzer

# Maximum Statement PDF Upload Size in Bytes (Default: 25 MB)
MAX_FILE_SIZE_BYTES=26214400

# OCR Configuration (Used by Python Service)
ENABLE_OCR=true
TESSERACT_CMD=

# Enterprise Cloud Document Processing Adapter (Optional)
# Supported: azure | aws_textract | google_docai | none
DOC_AI_PROVIDER=none
DOC_AI_API_KEY=
DOC_AI_ENDPOINT=

# Security & Session Secret (Generate a 32+ character random string in production)
SESSION_SECRET=change-this-to-a-secure-random-secret-in-production
